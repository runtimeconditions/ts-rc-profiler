{
  "name": "@runtimeconditions/typescript-profiler",
  "version": "0.1.0",
  "description": "Turns declarations in a TypeScript codebase into a validated Runtime Conditions Profile",
  "keywords": [
    "runtime-conditions",
    "profiler",
    "typescript",
    "static-analysis"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runtimeconditions/ts-rc-profiler.git"
  },
  "homepage": "https://github.com/runtimeconditions/ts-rc-profiler#readme",
  "bugs": {
    "url": "https://github.com/runtimeconditions/ts-rc-profiler/issues"
  },
  "bin": {
    "runtimeconditions-typescript-profiler": "dist/src/main.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "schemas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm ci --prefix test/fixtures/catalog --ignore-scripts --no-audit --no-fund && tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43"
  }
}
